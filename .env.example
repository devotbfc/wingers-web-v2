# Wingers Web .env.example
# Copy to .env.local and fill in real values. Never commit .env.local.
# All values mirrored in Vercel → Settings → Environment Variables.

# ============================================================
# PUBLIC (NEXT_PUBLIC_*) — visible to the browser
# ============================================================

# The absolute URL of this deployment. Used for canonical URLs, OG images,
# sitemap.xml absolute URLs, and location JSON-LD @id/url fields.
#
# Resolution (see src/lib/site-url.ts):
#   1. NEXT_PUBLIC_APP_URL (this file) wins when set
#   2. On Vercel previews (VERCEL_ENV !== "production") falls through to VERCEL_URL
#   3. Final fallback: https://wingers.co (production)
#
# Local dev: use the port Next starts on (3006 — see package.json dev script).
# Production (Vercel): set to https://wingers.co in Production env vars only;
# leave unset for Preview so previews don't advertise the live domain.
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Supabase project URL (EU region). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key. Browser-safe. Used by the loyalty signup Server Action.
# Row Level Security allows INSERT-only on loyalty_signups (ADR-016).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Supabase service-role key. SERVER ONLY — bypasses RLS. Used by the
# franchise enquiry Server Action to write to franchise_enquiries (which has
# RLS on and no anon/authenticated grants). NEVER prefix with NEXT_PUBLIC_
# and never read or log the value.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Pixel ID (browser-side). Leave unset locally to disable pixel loading —
# nothing loads, no consent banner, no console errors. See ADR-017.
NEXT_PUBLIC_META_PIXEL_ID=

# ============================================================
# PHASE G+ — add when Mailchimp sync, transactional email,
# analytics, and error tracking come online.
# ============================================================

# Mailchimp API credentials. SERVER ONLY.
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us12
# MAILCHIMP_AUDIENCE_ID=abc123def4
# MAILCHIMP_SERVER_PREFIX=us12

# PostHog (EU instance for UK data residency)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
# SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=sntrys_xxx

# Resend (transactional email — confirmation, contact form forwarding)
# RESEND_API_KEY=re_xxx
