# Wingers Web .env.example
# Copy to .env.local and fill in real values. Never commit .env.local.
# All values mirrored in Vercel → Settings → Environment Variables.

# ============================================================
# PUBLIC (NEXT_PUBLIC_*) — visible to the browser
# ============================================================

# The absolute URL of this deployment. Used for canonical URLs, OG images,
# sitemap.xml absolute URLs, and location JSON-LD @id/url fields.
#
# Resolution (see src/lib/site-url.ts):
#   1. NEXT_PUBLIC_APP_URL (this file) wins when set
#   2. On Vercel previews (VERCEL_ENV !== "production") falls through to VERCEL_URL
#   3. Final fallback: https://wingers.co (production)
#
# Local dev: use the port Next starts on (3006 — see package.json dev script).
# Production (Vercel): set to https://wingers.co in Production env vars only;
# leave unset for Preview so previews don't advertise the live domain.
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Supabase project URL (EU region). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key. Browser-safe. Currently unused — the loyalty Server
# Action moved to the service role in S1 (commit f84276a). Kept for future
# client-side reads; safe to leave at the example value locally.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Supabase service-role key. SERVER ONLY — bypasses RLS. Used by BOTH the
# loyalty signup Server Action (writes to loyalty_signups) and the franchise
# enquiry Server Action (writes to franchise_enquiries). Both tables have
# RLS on with no anon/authenticated grants. NEVER prefix with NEXT_PUBLIC_
# and never read or log the value.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Pixel ID (browser-side). Leave unset locally to disable pixel loading —
# nothing loads, no consent banner, no console errors. See ADR-017.
NEXT_PUBLIC_META_PIXEL_ID=

# ============================================================
# PHASE M+ — Brevo (loyalty list + transactional email),
# analytics, and error tracking.
# ============================================================

# Brevo API key. Server-only, set in Vercel, never commit.
# BREVO_API_KEY=xkeysib-...

# Brevo list id for the Wingers loyalty list.
# Server-only, set in Vercel, never commit.
# BREVO_LIST_ID=3

# Verified sender address for Brevo transactional email.
# Server-only, set in Vercel, never commit.
# BREVO_SENDER_EMAIL=hello@wingers.co

# Internal inbox that receives franchise enquiry alerts.
# Server-only, set in Vercel, never commit.
# FRANCHISE_ALERT_TO=admin@thebigflavour.com

# PostHog (EU instance for UK data residency)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry
# SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=sntrys_xxx
